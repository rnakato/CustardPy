#!/bin/bash
set -euo pipefail

printHelpAndExit() {
    echo "Usage: ${0##*/} [options] <outputdir> <hic> <chr> <start> <end> <resolution>"
    echo "  <outputdir>: directory where the PHi-C2 output directory will be created"
    echo "  <hic>: input Hi-C file (.hic or .mcool)"
    echo "  <chr> <start> <end>: chromosome, start and end positions for simulation"
    echo "  <resolution>: resolution of the matrix"
    echo -e "\n  Options:"
    echo "     -n <norm>: normalization type (NONE|VC|VC_SQRT|KR|SCALE, default: SCALE)"
    echo "     -t <tolerance>: NaN filtering threshold for phic preprocessing (default: 0.4)"
    echo "     -f <frame>: Number of framesg (default: 500)"
    echo -e "\n  Example:"
    echo "     ${0##*/} CustardPyResults/sample1 contact.hic 21 24000000 32000000 25000"
    exit 0
}

norm="SCALE"
tolerance=0.4
frame=500

while getopts "n:t:f:" opt; do
    case $opt in
        n) norm=$OPTARG;;
        t) tolerance=$OPTARG;;
        f) frame=$OPTARG;;
        h) printHelpAndExit;;
        [?]) printHelpAndExit;;
        esac
done
shift $((OPTIND - 1))

if [ $# -ne 6 ]; then
    printHelpAndExit
fi

odir=$1
hic=$2
chr=$3
start=$4
end=$5
resolution=$6
#tolerance=${8:-0.4}

echo "Input:"
echo "   hic: $hic"
echo "   chr: $chr"
echo "   start: $start"
echo "   end: $end"
echo "   resolution: $resolution"
echo "   norm: $norm"
echo "   tolerance: $tolerance"
echo -e "   frame: $frame\n"

plt_max_c=0.1
plt_max_k=0.1
interval=100
#frame=500
sample=500
filter_findfont_stderr() {
    grep -Ev "^findfont: .*Arial.*" >&2 || true
}

ex(){ echo "$1"; eval "$1"; }

originaldir=$(pwd)

mkdir -p "$odir"
cd "$odir"

hicbase=$(basename "$hic")
hicbase=${hicbase%.*}
name="${hicbase}_${norm}_chr${chr}_${start}-${end}_res${resolution}bp"

if [[ "$hic" = /* ]]; then
    hic_path="$hic"
else
    hic_path="$originaldir/$hic"
fi

echo "Inspect Hi-C file..."

ex "phic fetch-fileinfo --input $hic_path"

echo "Start 4D simulation by PHi-C2..."
ex "phic preprocessing \
    --input $hic_path \
    --res $resolution \
    --plt-max-c $plt_max_c \
    --chr $chr \
    --grs $start \
    --gre $end \
    --norm $norm \
    --tolerance $tolerance \
    2> >(filter_findfont_stderr)"

ex "phic optimization --name $name"
ex "phic plot-optimization --name $name --plt-max-c $plt_max_c --plt-max-k $plt_max_k \
    2> >(filter_findfont_stderr)"
ex "phic dynamics --name $name --interval $interval --frame $frame"
ex "phic sampling --name $name --sample $sample"
echo "done."

echo "Estimate dynamics-derived spectra..."
ex "phic msd --name $name"
ex "phic plot-msd --name $name --plt-upper 3 --plt-lower 0 --plt-max-log 2.0 --plt-min-log 0.5 --aspect 1.5 \
    2> >(filter_findfont_stderr)"
ex "phic losstangent --name $name"
ex "phic plot-losstangent --name $name --plt-upper 0 --plt-lower -3 --plt-max-log 0.3 --aspect 1.5 \
    2> >(filter_findfont_stderr)"
echo "done."

echo "Generate Hi-C map movie..."
N=$(( (end - start) / resolution + 1 ))
ex "plot_distance_map.py $name/data_dynamics/sample0.xyz $N $frame $name/distance_map/ \
    2> >(filter_findfont_stderr)"

